# Application
NODE_ENV=development
PORT=8080

# MongoDB
MONGODB_URI=mongodb://localhost:27017/parking_pulse
MONGODB_POOL_SIZE=10

# Security - CRITICAL: Set these in production
API_KEYS=your-secret-api-key-1,your-secret-api-key-2
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Alert Configuration
ALERT_TEMP_THRESHOLD_C=70
ALERT_TEMP_CRITICAL_C=80
ALERT_DEDUP_WINDOW_MS=300000

# Device Monitoring
DEVICE_OFFLINE_TIMEOUT_MS=120000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
